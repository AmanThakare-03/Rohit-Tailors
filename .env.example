# Meta WhatsApp Cloud API (SERVER ONLY - never prefix these with VITE_)
WHATSAPP_ACCESS_TOKEN=your_permanent_meta_access_token
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
SHOP_WHATSAPP_NUMBER=919713709112

# Optional: for production/business-initiated messages outside the 24-hour window.
# Create/approve this template in WhatsApp Manager first, then set the exact name here.
# Expected body variables: {{1}} name, {{2}} phone, {{3}} service, {{4}} date, {{5}} time, {{6}} requirements
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
